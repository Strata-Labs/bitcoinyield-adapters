{
  "name": "@bitcoinyield/adapters",
  "version": "0.1.0",
  "description": "Open-source Bitcoin yield adapter framework. Add a protocol once, run it everywhere.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "import": "./dist/src/server.js"
    }
  },
  "bin": {
    "bitcoinyield-adapter": "./src/cli/bin.ts"
  },
  "files": [
    "dist",
    "src",
    "adapters",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "pnpm registry:build && tsc",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli/bin.ts",
    "test": "tsx src/cli/bin.ts test",
    "validate": "tsx src/cli/bin.ts validate",
    "list": "tsx src/cli/bin.ts list",
    "registry:build": "tsx scripts/build-registry.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "vercel-build": "pnpm build",
    "prepare": "tsx scripts/build-registry.ts || true"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^3.4.0",
    "@stacks/network": "^7.3.1",
    "@stacks/transactions": "^7.4.0",
    "decimal.js": "^10.6.0",
    "inngest": "^3.54.2",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true
}
