{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@bitcoinyield/adapters": ["./src/index.ts"],
      "@bitcoinyield/adapters/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "adapters/**/*", "api/**/*", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
